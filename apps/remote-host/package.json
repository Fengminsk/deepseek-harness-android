{
  "name": "@deepseek-ai/dsh-remote-host",
  "description": "Remote DSH host: the PC-side wss://<host>:<port>/app endpoint that serves the same JSON-RPC facade method table to the Android app",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "apps/remote-host"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/*.js",
    "lib/types/*.d.ts",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/schemastery": "workspace:~",
    "@deepseek-ai/dsh-sdk-protocol": "workspace:*",
    "@deepseek-ai/dsh-home-paths": "workspace:*",
    "@deepseek-ai/dsh-atomic-write": "workspace:*",
    "@deepseek-ai/dsh-credentials": "workspace:*",
    "@minnnng/dsh-android-runtime": "workspace:*",
    "ws": "^8.21.3",
    "selfsigned": "^5.5.0"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "@types/node": "^22.20.1"
  },
  "engines": {
    "node": ">=24.9.0"
  }
}
