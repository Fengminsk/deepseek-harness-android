# The source preparation command verifies the official archive, applies the
# reviewed embedding patch and records all resulting source hashes.
set(TINYEMU_BUILD_RECORD "${REPOSITORY_ROOT}/.cache/android/tinyemu-probe/build/latest.json")
if(NOT EXISTS "${TINYEMU_BUILD_RECORD}")
  message(FATAL_ERROR "Run node apps/android/tool/build-tinyemu.mjs before building the Linux VM provider")
endif()
file(READ "${TINYEMU_BUILD_RECORD}" TINYEMU_RECORD)
string(JSON TINYEMU_SOURCE GET "${TINYEMU_RECORD}" source)
file(TO_CMAKE_PATH "${TINYEMU_SOURCE}" TINYEMU_SOURCE)
string(JSON TINYEMU_SOURCE_ARCHIVE_SHA GET "${TINYEMU_RECORD}" sourceArchive sha256)
if(NOT TINYEMU_SOURCE_ARCHIVE_SHA STREQUAL "be8351f2121819b3172fcedce5cb1826fa12c87da1b7ed98f269d3e802a05555")
  message(FATAL_ERROR "TinyEMU source archive differs from the pinned release")
endif()
string(JSON TINYEMU_PATCH_SHA GET "${TINYEMU_RECORD}" patchSha256)
file(SHA256 "${REPOSITORY_ROOT}/apps/android/tool/patch-tinyemu.mjs" TINYEMU_CURRENT_PATCH_SHA)
if(NOT TINYEMU_PATCH_SHA STREQUAL TINYEMU_CURRENT_PATCH_SHA)
  message(FATAL_ERROR "TinyEMU embedding patch changed; regenerate its source preparation record")
endif()
set(TINYEMU_INPUTS virtio pci fs cutils iomem simplefb riscv_machine softfp)
set(TINYEMU_SOURCES)
foreach(NAME IN LISTS TINYEMU_INPUTS)
  list(APPEND TINYEMU_SOURCES "${TINYEMU_SOURCE}/${NAME}.c")
endforeach()
string(JSON TINYEMU_HEADER_COUNT LENGTH "${TINYEMU_RECORD}" headers)
math(EXPR TINYEMU_HEADER_LAST "${TINYEMU_HEADER_COUNT} - 1")
foreach(INDEX RANGE ${TINYEMU_HEADER_LAST})
  string(JSON NAME GET "${TINYEMU_RECORD}" headers ${INDEX} name)
  file(SHA256 "${TINYEMU_SOURCE}/${NAME}" ACTUAL)
  string(JSON EXPECTED GET "${TINYEMU_RECORD}" headers ${INDEX} sha256)
  if(NOT ACTUAL STREQUAL EXPECTED)
    message(FATAL_ERROR "Prepared TinyEMU header changed: ${NAME}")
  endif()
endforeach()
string(JSON TINYEMU_INPUT_COUNT LENGTH "${TINYEMU_RECORD}" inputs)
math(EXPR TINYEMU_INPUT_LAST "${TINYEMU_INPUT_COUNT} - 1")
foreach(INDEX RANGE ${TINYEMU_INPUT_LAST})
  string(JSON NAME GET "${TINYEMU_RECORD}" inputs ${INDEX} name)
  if(NAME STREQUAL "linux_vm_engine" OR NAME STREQUAL "linux_vm_files")
    continue() # The repository JNI owner is rebuilt from its current source.
  endif()
  if(NAME STREQUAL "riscv_cpu32" OR NAME STREQUAL "riscv_cpu64")
    set(INPUT_FILE "${TINYEMU_SOURCE}/riscv_cpu.c")
  else()
    set(INPUT_FILE "${TINYEMU_SOURCE}/${NAME}.c")
  endif()
  file(SHA256 "${INPUT_FILE}" ACTUAL)
  string(JSON EXPECTED GET "${TINYEMU_RECORD}" inputs ${INDEX} sha256)
  if(NOT ACTUAL STREQUAL EXPECTED)
    message(FATAL_ERROR "Prepared TinyEMU source changed: ${NAME}")
  endif()
endforeach()
foreach(XLEN 32 64)
  add_library(pocket_riscv_cpu${XLEN} OBJECT "${TINYEMU_SOURCE}/riscv_cpu.c")
  set_target_properties(pocket_riscv_cpu${XLEN} PROPERTIES POSITION_INDEPENDENT_CODE TRUE)
  target_compile_definitions(pocket_riscv_cpu${XLEN} PRIVATE MAX_XLEN=${XLEN} CONFIG_RISCV_MAX_XLEN=64)
  target_compile_options(pocket_riscv_cpu${XLEN} PRIVATE -O2 -fno-strict-aliasing)
endforeach()
add_library(pocket_linux_vm SHARED linux_vm_engine.c linux_vm_files.c ${TINYEMU_SOURCES}
  $<TARGET_OBJECTS:pocket_riscv_cpu32> $<TARGET_OBJECTS:pocket_riscv_cpu64>)
target_include_directories(pocket_linux_vm PRIVATE "${TINYEMU_SOURCE}")
target_compile_definitions(pocket_linux_vm PRIVATE _GNU_SOURCE _FILE_OFFSET_BITS=64
  _LARGEFILE_SOURCE CONFIG_RISCV_MAX_XLEN=64 CONFIG_VERSION="2019-12-21")
target_compile_options(pocket_linux_vm PRIVATE -O2 -fno-strict-aliasing)
target_link_libraries(pocket_linux_vm m)
target_link_options(pocket_linux_vm PRIVATE "-Wl,--no-undefined" "-Wl,-z,max-page-size=16384")
